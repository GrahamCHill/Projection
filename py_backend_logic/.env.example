GROQ_API_KEY=b78uiajnfeuw8EXAMPLEhefu8w

# Database Configuration
# PostgreSQL is the only supported database

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=projection

# S3 Storage Configuration
# Set USE_MOCK_S3=true to use MinIO (local S3-compatible storage)
# Set USE_MOCK_S3=false to use real AWS S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=projection
USE_MOCK_S3=true

# Vector Database Configuration
VECTOR_DB_URL=http://qdrant:6333

# GitHub Configuration
# Personal access token with repo scope
GITHUB_TOKEN=your_github_token_here
# GitHub Enterprise URL (leave empty for github.com)
GITHUB_ENTERPRISE_URL=
# Polling interval in seconds (default: 600 = 10 minutes)
GITHUB_POLLING_INTERVAL=600
# Comma-separated list of GitHub usernames to monitor
GITHUB_USERS=username1,username2
# Comma-separated list of GitHub organizations to monitor
GITHUB_ORGANIZATIONS=org1,org2

# Redis Cache Configuration
# Set REDIS_ENABLED=true to use Redis for caching user-role combinations
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT Authentication Configuration
JWT_SECRET_KEY=your-secret-key-for-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG
LOG_DIR=logs
MAX_LOG_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Metrics Configuration
METRICS_ENABLED=true
METRICS_RETENTION_MINUTES=60
METRICS_SNAPSHOT_INTERVAL_SECONDS=60
METRICS_DIR=metrics

# Plugin Configuration
PLUGINS_ENABLED=true
PLUGINS_DIR=plugins
PLUGIN_CONFIG_FILE=plugin_config.json

# Server Configuration
PORT=8000
HOST=0.0.0.0